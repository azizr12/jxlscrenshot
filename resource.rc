#include "resource.h"
#include <winver.h> // defines VS_VERSION_INFO (= 1); without it the block is
                    // stored under a string name and Windows ignores it

// Embed the custom application icon
IDI_APP_ICON ICON "icon.ico"

// Embed the manifest to force Common Controls v6 (Required for TaskDialogIndirect)
// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
1 24 "app.manifest"

// File version properties (shown in Explorer / file properties).
// The numbers come from resource.h so they can never drift from APP_VERSION.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "azizr12"
            VALUE "FileDescription",  "JXL Screenshot Tool"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "jxlshot_tray"
            VALUE "LegalCopyright",   "Copyright (c) 2026 azizr12"
            VALUE "OriginalFilename", "jxlshot_tray.exe"
            VALUE "ProductName",      "jxlshot"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
